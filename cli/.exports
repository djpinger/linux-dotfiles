if [[ -t 0 && $- = *i* ]]; then
  stty -ixon
fi
unset AWS_PROFILE
[ -d /usr/local/Cellar ] && export PATH=$PATH:/usr/local/Cellar
export PATH=/var/lib/snapd/snap/bin:/usr/local/bin:/usr/local/sbin:$PATH
#eval $(keychain --eval --agents ssh --inherit any id_ed25519 id_ed25519_work)
# One long-lived ssh-agent of our own, at a FIXED socket path, on every OS.
#
# The previous version started no agent on macOS and inherited whatever launchd
# handed over. That socket path is regenerated when the agent is replaced, so an
# exported SSH_AUTH_SOCK outlived the agent it named: `ssh-add -l` returned 2,
# `ssh-add` printed "Error connecting to agent: No such file or directory", and
# anything needing a signature failed.
#
# A fixed path fixes it by construction: a replacement agent binds the same address,
# so no shell can be left holding a dead one. `ssh-add -l` exits 2 when it cannot
# connect, 0 or 1 when it can (1 just means the agent is empty), so 2 is the only
# case where a new agent is needed. The socket file is removed first because
# `ssh-agent -a` refuses to bind over an existing path, and we only reach that line
# when nothing is answering on it.
export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
ssh-add -l &>/dev/null
if (( $? == 2 )); then
  rm -f "$SSH_AUTH_SOCK"
  eval "$(ssh-agent -a "$SSH_AUTH_SOCK" -s)" >/dev/null
fi
# Add every ~/.ssh/id_* private key the agent is not already holding, so a passphrase
# is asked for once per agent rather than once per shell. `ssh-add -l` prints each
# key's comment, not its path, so "already holding" is decided by fingerprint.
_ssh_loaded=$(ssh-add -l 2>/dev/null)
for _ssh_key in ~/.ssh/id_*(N); do
  [[ $_ssh_key == *.pub ]] && continue
  _ssh_fp=$(ssh-keygen -lf "$_ssh_key.pub" 2>/dev/null | awk '{print $2}')
  [[ -n $_ssh_fp && $_ssh_loaded == *"$_ssh_fp"* ]] || ssh-add -q "$_ssh_key"
done
unset _ssh_key _ssh_fp _ssh_loaded
[ -f /usr/share/fzf/completion.zsh ] && source /usr/share/fzf/completion.zsh
[ -f /usr/share/fzf/key-bindings.zsh ] && source /usr/share/fzf/key-bindings.zsh
if [ -x /usr/bin/dircolors ]; then
  test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
  #alias ls='ls --color=auto'
  #alias dir='dir --color=auto'
  #alias vdir='vdir --color=auto'
  alias grep='grep --color=auto'
  alias fgrep='fgrep --color=auto'
  alias egrep='egrep --color=auto'
fi
[ -f /usr/local/etc/profile.d/autojump.sh ] && . /usr/local/etc/profile.d/autojump.sh
[[ $commands[kubectl] ]] && source <(kubectl completion zsh)
[ -f /opt/homebrew/opt/asdf/libexec/asdf.sh ] && . /opt/homebrew/opt/asdf/libexec/asdf.sh
[ -f /opt/asdf-vm/asdf.sh ] && . /opt/asdf-vm/asdf.sh
[ -f /usr/local/opt/asdf/libexec/asdf.sh ] && . /usr/local/opt/asdf/libexec/asdf.sh
[ -f ~/.asdf/plugins/java/set-java-home.zsh ] && . ~/.asdf/plugins/java/set-java-home.zsh
[ -f /home/linuxbrew/.linuxbrew/opt/asdf/libexec/asdf.sh ] && . /home/linuxbrew/.linuxbrew/opt/asdf/libexec/asdf.sh
[ -f ~/fubectl.source ] && . ~/fubectl.source
export PATH=$PATH:$HOME/.asdf
export PATH="/home/linuxbrew/.linuxbrew/opt/openssl@3/bin:$PATH"
export PKG_CONFIG_PATH="/home/linuxbrew/.linuxbrew/opt/openssl@3/lib/pkgconfig"
# gcloud stuff
[ -f /opt/homebrew/share/zsh/site-functions/_google_cloud_sdk ] && source "/opt/homebrew/share/zsh/site-functions/_google_cloud_sdk"
export PATH=$PATH:/opt/homebrew/share/google-cloud-sdk/bin
# `deploy_local` builds with `docker build --secret id=GOOGLE_APPLICATION_CREDENTIALS,
# src=$GOOGLE_APPLICATION_CREDENTIALS`, which fails on an empty src rather than falling
# back to ADC. Point it at the ADC file gcloud already writes. Only set when it exists,
# so a machine without `gcloud auth application-default login` doesn't export a dead path.
[ -f "$HOME/.config/gcloud/application_default_credentials.json" ] && \
  export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/gcloud/application_default_credentials.json"
#if [ $TILIX_ID ] || [ $VTE_VERSION ]; then
#    source /etc/profile.d/vte.sh
#fi
#
# EXPORTS
#
if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ]; then
  export STARSHIP_CONFIG="$HOME/.config/starship-ssh.toml"
fi
export EDITOR=vim
export BLOCKSIZE=1k
export CLICOLOR=1
export LSCOLORS=ExFxBxDxCxegedabagacad
export GOPATH=$HOME/go
export PATH=$PATH:$GOPATH/bin
export COLORTERM=truecolor
export TERM=xterm-256color
export USE_GKE_GCLOUD_AUTH_PLUGIN=True
export PODMAN_COMPOSE_WARNING_LOGS=false
#
# RUBY
#
#eval "$(rbenv init -)"
#
# NODE
#
#source /usr/share/nvm/init-nvm.sh
#
# AWS
#
#source $(which assume-role)
export AWS_VAULT_PROMPT=terminal
export AWS_SESSION_TOKEN_TTL=12h
export AWS_CHAINED_SESSION_TOKEN_TTL=12h
export AWS_ASSUME_ROLE_TTL=12h
export AWS_FEDERATION_TOKEN_TTL=12h
#
# PYTHON
#
#export PATH="$HOME/.pyenv/bin:$PATH"
#eval "$(pyenv init -)"
#eval "$(pyenv virtualenv-init -)"

export PATH=~/.local/bin/:~/bin:$PATH
export GITHUB_TOKEN=$(gh auth token)
#
# MAC GNU STUFF
#
PATH="/opt/homebrew/opt/make/libexec/gnubin:$PATH"
PATH="$PATH:$HOME/.rd/bin"
#
# PICNIC STUFF
#
#
# BUN STUFF
#
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
#
# ZOXIDE STUFF
#
eval "$(zoxide init zsh)"
#
# NPM STUFF
#
export PATH=~/.npm-global/bin:$PATH
#
# LMSTUDIO STUFF
#
[ -d "$HOME/.lmstudio/bin" ] && export PATH="$PATH:$HOME/.lmstudio/bin"
#
# Obsidian CLI
#
export PATH=$PATH:/usr/local/bin/obsidian
#
# Opencode
#
export PATH=~/.opencode/bin:$PATH
#
# GOOGLE CLOUD SDK PYTHON
# Homebrew python upgrades delete the interpreter gcloud hardcodes, which breaks
# both gcloud and gke-gcloud-auth-plugin. Pin CLOUDSDK_PYTHON to the first
# python3 that exists (macOS Homebrew arm/intel, then Linux). Only set if found.
#
for _py in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
  [ -x "$_py" ] && export CLOUDSDK_PYTHON="$_py" && break
done
unset _py
