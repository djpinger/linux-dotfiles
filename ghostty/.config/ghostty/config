# Include machine-specific config (not tracked in git)
config-file = ~/.config/ghostty/local.config

font-family = "MesloLGM Nerd Font Mono"
# font-size is set in local.config (machine-specific)
#font-feature = -liga
font-thicken = true
font-style = Regular
theme = catppuccin-mocha
quit-after-last-window-closed = true
window-decoration = auto

# Kitty-style cursor_trail lookalike (MIT, github.com/sahaj-b/ghostty-cursor-shaders).
# `always` (not just while focused) avoids the shader freezing mid-animation
# when the window loses focus while the shell has a line cursor at the prompt.
custom-shader = shaders/cursor_tail.glsl
custom-shader-animation = always

# Bell: dash "needs attention" hint only. Not `system` — that fires a real
# desktop notification that must be manually dismissed, or its unread count
# gets stuck on the dash icon even after Ghostty quits (GNOME's per-app
# notification badge is independent of the process).
bell-features = attention

# Enable mouse reporting for tmux
mouse-hide-while-typing = false
click-repeat-interval = 0
copy-on-select = clipboard
keybind = shift+enter=text:\x1b\r
